{
  "name": "serial-scanning-label-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-vicimus",
    "seed:dev": "node scripts/seed-dev.mjs",
    "test": "firebase emulators:exec --only firestore --project demo-vicimus \"vitest run\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-vicimus \"node --test firestore-tests/*.test.mjs\"",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "verify:bundle": "node scripts/verify-prod-bundle.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/library": "^0.23.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
