# Copy to .env.local (git-ignored) and fill in from the Firebase console:
# Project settings > General > Your apps > Web app.
# These values identify the Firebase project; they are NOT secrets, but access is
# controlled by Firebase Auth + Firestore Security Rules (firestore.rules), not by hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, dev server only: run against local Firebase emulators (npm run emulators).
# When true, the values above may be left empty. Ignored in production builds.
# VITE_USE_FIREBASE_EMULATOR=true

# Optional label stock / printer settings (build time). Defaults: 70 x 35 mm at 203 dpi (development values).
# Set these to the REAL label and printer after the calibration in docs/PRINT_CALIBRATION.md.
# VITE_LABEL_WIDTH_MM=70
# VITE_LABEL_HEIGHT_MM=35
# VITE_LABEL_DPI=203
